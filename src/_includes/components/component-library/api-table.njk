{% set apiProps = props or [] %}
<div class="component-library-table-wrap">
  <table class="component-library-table">
    <thead>
      <tr>
        <th scope="col">Field / prop name</th>
        <th scope="col">Type</th>
        <th scope="col">Required?</th>
        <th scope="col">Default / fallback</th>
        <th scope="col">Notes</th>
      </tr>
    </thead>
    <tbody>
      {% for prop in apiProps %}
      <tr>
        <td><code>{{ prop.name }}</code></td>
        <td>{{ prop.type }}</td>
        <td>{{ "Yes" if prop.required else "No" }}</td>
        <td>{{ prop.default or "None" }}</td>
        <td>{{ prop.notes or "—" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
