<section class="section module-metrics">
  {% set m = module or section %}
  <div class="container">
    {% if m.title %}<h2 class="section__title">{{ m.title }}</h2>{% endif %}
    {% if m.caption %}<p class="muted">{{ m.caption }}</p>{% endif %}
    <ul class="metric-row">
      {% for metric in m.metrics %}
        <li class="metric">
          <span class="metric__value">{{ metric.value }}</span>
          <span class="metric__label">{{ metric.label }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
